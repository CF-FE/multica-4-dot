# Copy into root-only /etc/multica-backend/oauth.env and fill actual values.
# Single quotes preserve the JSON double quotes in systemd EnvironmentFile.
MULTICA_MCP_PUBLIC_BASE_URL=https://example.invalid/multica-backend
MULTICA_MCP_GITHUB_PRINCIPALS='{"REPLACE_WITH_GITHUB_NUMERIC_ID":{"scopes":["read"]}}'
MULTICA_MCP_ALLOWED_REDIRECT_URIS='["https://example.invalid/replace-with-exact-host-callback"]'
